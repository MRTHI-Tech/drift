# Copy to .env.local and fill in. .env.local is gitignored. Never commit a
# secret, never log one. In deployed environments these come from Secret
# Manager, not from a file.
# Canonical list: AGENTS.md section 8.

# Gemini API key. Every model call goes through Genkit in packages/agent.
GEMINI_API_KEY=

# Google Cloud
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE=(default)
STORAGE_BUCKET=

# GitHub, two credentials. The app is the one that is meant to win: it is
# installed onto the repos a person picked, so GitHub scopes its reach. The PAT
# is the fallback, for a deployment with no app and for projects that predate
# one. Leave the app pair empty and everything runs on the PAT exactly as before.
GITHUB_TOKEN=

# GitHub App. The private key is a multi-line PEM, which a .env file cannot
# hold, so base64 it onto one line: base64 -i your-key.pem | tr -d '\n'
# The raw PEM is also accepted, for Secret Manager, where newlines survive.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Comma-separated owner/name. Hard gate: Drift refuses to open a PR against any
# repo not on this list, regardless of what Firestore says. Kept alongside the
# app on purpose: the installation already scopes what Drift can reach, and this
# stays as the second lock until that has been proven in a deployment.
GITHUB_REPO_ALLOWLIST=

# Value the render worker puts in the cookie a project's drift.config.json
# names in authCookieName. Leave empty for projects whose routes are public.
PREVIEW_AUTH_COOKIE_VALUE=

# Firebase Auth client config (Google provider only)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Dashboard
NEXT_PUBLIC_APP_URL=http://localhost:3000
