{
  "name": "drift",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @drift/dashboard dev",
    "build": "pnpm -r --sequential build",
    "typecheck": "pnpm -r --sequential typecheck",
    "test": "pnpm -r --sequential test",
    "worker": "pnpm --filter @drift/worker start",
    "seed": "pnpm --filter @drift/core seed --"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
